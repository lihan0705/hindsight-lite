{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__SCRIPTS_DIR__/codex_hook.py\" SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__SCRIPTS_DIR__/codex_hook.py\" UserPromptSubmit",
            "timeout": 12
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Read$|^Bash$|^mcp__.+__(read|view|cat)(_file|_files)?$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__SCRIPTS_DIR__/codex_hook.py\" PreToolUse",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__SCRIPTS_DIR__/codex_hook.py\" Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
